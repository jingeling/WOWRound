{
  "name": "wowround",
  "version": "0.1.0",
  "description": "Zelf gehoste 1-op-1 video voor samenwerken op afstand. Zwevende bubbels, scherp schermdelen, peer-to-peer.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch server/index.js",
    "hash-password": "node scripts/hash-password.js",
    "gen-secret": "node scripts/gen-secret.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/two-browsers.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
