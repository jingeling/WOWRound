# WOWRound — configuratie
# Kopieer naar .env en vul in. Zet .env nooit in git (staat al in .gitignore).

# Het publieke adres waarop je WOWRound bereikt. Buiten ontwikkelmodus verplicht https.
PUBLIC_URL=https://bel.jouwdomein.nl

# Waar de Node-server op luistert. Laat op 127.0.0.1 staan: alleen je reverse proxy
# (Caddy) hoort erbij te kunnen, niet het hele internet.
HOST=127.0.0.1
PORT=3000

# Zet op true als WOWRound achter Caddy of nginx draait, zodat het echte IP-adres
# wordt gebruikt voor het begrenzen van inlogpogingen.
TRUST_PROXY=true

# Geheim voor het ondertekenen van gastlinks. Maak met: npm run gen-secret
# Let op: dit geheim vervangen maakt ALLE bestaande gastlinks ongeldig.
APP_SECRET=

# Hash van het eigenaarswachtwoord. Maak met: npm run hash-password
OWNER_PASSWORD_HASH=

# Hoe lang je ingelogd blijft (uren).
SESSION_TTL_HOURS=12

# Map voor rooms.json. Bevat alleen ruimtenamen, geen gesprekken of gasten.
DATA_DIR=./data

# STUN-server(s), kommagescheiden. Nodig om elkaar te vinden achter een router.
# Standaard een Europese publieke STUN-server. Beter: draai je eigen coturn in
# STUN-modus (zie docs/BEVEILIGING.md) en zet die hier.
STUN_URLS=stun:stun.nextcloud.com:443

# Optioneel: eigen TURN-server voor als een rechtstreekse verbinding niet lukt
# (strenge bedrijfsfirewalls). Laat leeg als je geen TURN-server draait.
# TURN_URLS=turn:turn.jouwdomein.nl:3478?transport=udp,turns:turn.jouwdomein.nl:5349?transport=tcp
# TURN_SECRET=   (zelfde waarde als static-auth-secret in coturn; maak met npm run gen-secret)
# TURN_TTL_SECONDS=3600
